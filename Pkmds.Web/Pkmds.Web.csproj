<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Enable SIMD independently of AOT after the matched #883 evaluation.
             Final exception handling already sets a later browser feature floor.
             See docs/WASM_AOT_SIMD_EVALUATION.md and docs/BROWSER_SUPPORT.md. -->
        <WasmEnableSIMD>true</WasmEnableSIMD>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <BlazorWasmDebuggingEnabled>true</BlazorWasmDebuggingEnabled>
        <WasmNativeDebugSymbols>true</WasmNativeDebugSymbols>
        <BlazorWebAssemblyEnableLinking>false</BlazorWebAssemblyEnableLinking>
        <BlazorEnableCompression>false</BlazorEnableCompression>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <BlazorWebAssemblyEnableLinking>true</BlazorWebAssemblyEnableLinking>
        <BlazorEnableCompression>true</BlazorEnableCompression>
        <!-- Trim app code (PKHeX.Core, MudBlazor, Pkmds.Rcl) in addition to the
             framework. Saves ~610 KB brotli; safe because:
             - PreservePkmTypes.xml roots PKHeX's PKM type hierarchy for
               EntityBatchEditor's reflection path
             - Pkmds.Rcl/PreserveRoutes.xml roots Blazor's @page components
             - PreserveJSInvokable.xml + [DynamicDependency] attributes on
               RefreshService and EmbeddedHostBridge ctors root the [JSInvokable]
               static entry points called via DotNet.invokeMethodAsync
             - BankService / BackupService / EmbeddedHostBridge use source-gen
               JSON and pass JsonDocument.RootElement (trim-safe primitive)
               across the IJS boundary, so the reflection path through Blazor's
               internal JsonSerializer is no longer hit
             Initial flip in #883 broke Bank and Backup (issues #894/#896/#898);
             re-enabled in #902 after the IJS interop and [JSInvokable] surfaces
             were hardened. -->
        <TrimMode>full</TrimMode>
        <PublishTrimmed>true</PublishTrimmed>
        <!-- .NET 11 enables framework metrics, EventSource, and HTTP activity
             propagation by default. This static app has no telemetry consumer;
             trim those paths while retaining Serilog browser logging and stack
             traces. See docs/PUBLISH_TRIMMING.md for the measured comparison. -->
        <BlazorWebAssemblyDiagnosticsEnabled>false</BlazorWebAssemblyDiagnosticsEnabled>
        <!-- Evaluate AOT separately from SIMD using matched performance and
             application checks before changing the production default (#883). -->
        <RunAOTCompilation>false</RunAOTCompilation>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateServiceWorkerAssetsManifest>true</GenerateServiceWorkerAssetsManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pkmds.Rcl\Pkmds.Rcl.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js"/>
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootDescriptor Include="PreservePkmTypes.xml"/>
        <TrimmerRootDescriptor Include="PreserveJSInvokable.xml"/>
    </ItemGroup>

    <!-- Require boot-script fingerprints in the published static site; let the
         development server use the SDK's default asset naming and mapping. -->
    <ItemGroup Condition="'$(_IsPublishing)' == 'true'">
        <StaticWebAssetFingerprintPattern Include="BootScripts" Pattern="*.boot.js" Expression="#[.{fingerprint}]!"/>
    </ItemGroup>

    <!-- Generate a static asset from the resolved SDK properties, including CLI
         overrides. Keep it in the normal fingerprint/service-worker pipeline. -->
    <Target Name="GenerateBrowserRequirements" BeforeTargets="ResolveProjectStaticWebAssets">
        <PropertyGroup>
            <_BrowserRequiresExceptions>false</_BrowserRequiresExceptions>
            <_BrowserRequiresExceptions Condition="'$(WasmEnableExceptionHandling)' == 'true'">true</_BrowserRequiresExceptions>
            <_BrowserRequiresSIMD>false</_BrowserRequiresSIMD>
            <_BrowserRequiresSIMD Condition="'$(WasmEnableSIMD)' == 'true'">true</_BrowserRequiresSIMD>
            <_BrowserRequirementsRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'browser-support'))</_BrowserRequirementsRoot>
            <_BrowserRequirementsFile>$(_BrowserRequirementsRoot)js/browser-requirements.boot.js</_BrowserRequirementsFile>
        </PropertyGroup>
        <MakeDir Directories="$(_BrowserRequirementsRoot)js"/>
        <WriteLinesToFile File="$(_BrowserRequirementsFile)"
                          Lines="window.pkmdsBrowserRequirements = { exceptionHandling: $(_BrowserRequiresExceptions), simd: $(_BrowserRequiresSIMD) }%3B"
                          Overwrite="true" WriteOnlyWhenDifferent="true"/>
        <ItemGroup>
            <Content Include="$(_BrowserRequirementsFile)" Link="wwwroot/js/browser-requirements.boot.js" ContentRoot="$(_BrowserRequirementsRoot)"/>
            <FileWrites Include="$(_BrowserRequirementsFile)"/>
        </ItemGroup>
    </Target>

    <Target Name="CopyServiceWorkerPublished" AfterTargets="Publish">
        <Copy SourceFiles="wwwroot\service-worker.published.js" DestinationFiles="$(PublishDir)wwwroot\service-worker.published.js"/>
    </Target>

</Project>
