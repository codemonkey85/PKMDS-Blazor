@inherits RefreshAwareComponent

<MudGrid Spacing="1"
         Justify="@Justify.FlexStart"
         Class="@(AppState.PinnedBoxNumber is not null ? "party-box-grid pinned-box-grid" : "party-box-grid")">
    <MudItem xs="12"
             lg="6"
             Style="max-width: 480px;">
        <MudPaper Elevation="0"
                  Style="background-color: transparent;">
            <PokemonStorageComponent/>
        </MudPaper>
    </MudItem>
    <MudItem xs="12"
             lg="6"
             Class="edit-form-column">
        <MudPaper Elevation="0"
                  Style="background-color: transparent;">
            @if (AppState.PinnedBoxNumber is not null)
            {
                <PinnedBoxComponent/>
            }
            else
            {
                <PokemonEditForm Pokemon="@AppService.EditFormPokemon"/>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
