@inherits RefreshAwareComponent

@if (AppState is not { SaveFile: { } saveFile })
{
    @if (AppState.ShowProgressIndicator)
    {
        @* Mirror the eventual layout (save title row → tabs bar → content panel)
           so the skeleton lands where boxes will render rather than collapsing
           into a small top-left stack. *@
        <MudStack Spacing="3"
                  Class="save-file-loading-skeleton">
            <MudSkeleton SkeletonType="@SkeletonType.Text"
                         Width="40%"
                         Height="40px"/>
            <MudSkeleton SkeletonType="@SkeletonType.Rectangle"
                         Width="100%"
                         Height="48px"/>
            <MudSkeleton SkeletonType="@SkeletonType.Rectangle"
                         Width="100%"
                         Height="420px"/>
        </MudStack>
    }
}
else
{
    <PageTitle>
        @SaveFileNameDisplay.SaveFileNameDisplayString(AppState, AppService, true)
    </PageTitle>

    <MudText Typo="@Typo.h5">
        @SaveFileNameDisplay.SaveFileNameDisplayString(AppState, AppService)
    </MudText>

    @if (saveFile is SAV4BR battleRevolution)
    {
        <div class="flex flex-wrap items-center gap-3 my-3">
            <MudSelect T="@int"
                       Label="Active Battle Revolution profile"
                       Variant="@Variant.Outlined"
                       Margin="@Margin.Dense"
                       Value="@battleRevolution.CurrentSlot"
                       ValueChanged="@(profile => OnBattleRevolutionProfileChangedAsync(battleRevolution, profile))"
                       Style="min-width: 240px; max-width: 420px;">
                @for (var profile = 0; profile < battleRevolution.SaveNames.Count; profile++)
                {
                    var profileIndex = profile;
                    <MudSelectItem Value="@profileIndex"
                                   @key="@profileIndex">
                        @GetBattleRevolutionProfileLabel(battleRevolution, profileIndex)
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
    }

    <MudTabs Outlined
             Rounded
             Border
             Class="save-file-outer-tabs"
             @bind-ActivePanelIndex="@activeTabIndex">

        <MudTabPanel Text="Party / Box">
            <TabErrorBoundary TabName="Party / Box" @key="saveFile">
                <div class="mt-3 party-box-tab-content">
                    <PartyAndBoxTab/>
                </div>
            </TabErrorBoundary>
        </MudTabPanel>

        <MudTabPanel Text="Trainer">
            <TabErrorBoundary TabName="Trainer" @key="saveFile">
                <div class="mt-3 trainer-tab-content">
                    <TrainerInfoTab/>
                </div>
            </TabErrorBoundary>
        </MudTabPanel>

        @if (HasEditableInventory(saveFile))
        {
            <MudTabPanel Text="Bag">
                <TabErrorBoundary TabName="Bag" @key="saveFile">
                    <div class="mt-3">
                        <BagTab Inventory="@saveFile.Inventory"/>
                    </div>
                </TabErrorBoundary>
            </MudTabPanel>
        }

        @if (saveFile.Generation >= 4)
        {
            <MudTabPanel Text="Mystery Gifts">
                <TabErrorBoundary TabName="Mystery Gifts" @key="saveFile">
                    <div class="mt-3">
                        <MysteryGiftDatabaseTab/>
                    </div>
                </TabErrorBoundary>
            </MudTabPanel>
        }

        @if (AppService.HasWonderCardSlots())
        {
            <MudTabPanel Text="Wonder Cards">
                <TabErrorBoundary TabName="Wonder Cards" @key="saveFile">
                    <div class="mt-3">
                        <WonderCardsTab/>
                    </div>
                </TabErrorBoundary>
            </MudTabPanel>
        }

        @if (saveFile is SAV3 { Generation: 3 } sav3)
        {
            <MudTabPanel Text="Records">
                <TabErrorBoundary TabName="Records" @key="saveFile">
                    <RecordsTab SaveFile="@sav3"/>
                </TabErrorBoundary>
            </MudTabPanel>

            @if (saveFile is SAV3RS or SAV3E)
            {
                <MudTabPanel Text="RTC">
                    <TabErrorBoundary TabName="RTC" @key="saveFile">
                        <div class="mt-3">
                            <RtcTab SaveFile="@sav3"/>
                        </div>
                    </TabErrorBoundary>
                </MudTabPanel>
            }
        }

        @if (saveFile is SAV3RS or SAV3E or SAV4Sinnoh or SAV8BS)
        {
            <MudTabPanel Text="Feebas">
                <TabErrorBoundary TabName="Feebas" @key="saveFile">
                    <div class="mt-3 feebas-tab-content">
                        <FeebasLocatorTab/>
                    </div>
                </TabErrorBoundary>
            </MudTabPanel>
        }

        @if (saveFile.HasPokeDex)
        {
            <MudTabPanel Text="Pokédex">
                <TabErrorBoundary TabName="Pokédex" @key="saveFile">
                    <PokedexTab/>
                </TabErrorBoundary>
            </MudTabPanel>
        }

        @if (AppService.HasBattleBox() || AppService.HasBattleTeams() || AppService.HasRentalTeams())
        {
            <MudTabPanel Text="Teams">
                <TabErrorBoundary TabName="Teams" @key="saveFile">
                    <div class="mt-3 teams-tab-content">
                        <TeamsTab/>
                    </div>
                </TabErrorBoundary>
            </MudTabPanel>
        }

        <MudTabPanel Text="Legality Report">
            <TabErrorBoundary TabName="Legality Report" @key="saveFile">
                <div class="mt-3">
                    <LegalityReportTab OnJumpToPartyBox="@JumpToPartyBox"/>
                </div>
            </TabErrorBoundary>
        </MudTabPanel>

        <MudTabPanel Text="Search">
            <TabErrorBoundary TabName="Search" @key="saveFile">
                <div class="mt-3">
                    <AdvancedSearchTab OnJumpToPartyBox="@JumpToPartyBox"/>
                </div>
            </TabErrorBoundary>
        </MudTabPanel>

        <MudTabPanel Text="Encounter DB">
            <TabErrorBoundary TabName="Encounter DB" @key="saveFile">
                <div class="mt-3">
                    <EncounterDatabaseTab OnJumpToPartyBox="@JumpToPartyBox"/>
                </div>
            </TabErrorBoundary>
        </MudTabPanel>

        <MudTabPanel Text="Batch Editor">
            <TabErrorBoundary TabName="Batch Editor" @key="saveFile">
                <div class="mt-3">
                    <BatchEditorTab/>
                </div>
            </TabErrorBoundary>
        </MudTabPanel>

        @if (!HostService.IsEmbedded)
        {
            <MudTabPanel Text="Pokémon Bank">
                <TabErrorBoundary TabName="Pokémon Bank" @key="saveFile">
                    <div class="mt-3 bank-tab-content">
                        <PokemonBankTab/>
                    </div>
                </TabErrorBoundary>
            </MudTabPanel>

            <MudTabPanel Text="Trade">
                <TabErrorBoundary TabName="Trade" @key="saveFile">
                    <div class="mt-3 trade-tab-content">
                        <TradeTab/>
                    </div>
                </TabErrorBoundary>
            </MudTabPanel>
        }

    </MudTabs>
}
